# Keeps one outbound SSH local-forward tunnel open from arcturus to
# lyra, so `cora-api`'s status_push (cora.api._status_push) can reach
# the relay at ws://127.0.0.1:8099/ingest as if it were local, even
# though arcturus has no inbound reachability from lyra and 443 is
# refused outbound (verified 2026-08-28: getent resolves lyra, `nc -vz
# 443` is refused, `nc -vz 22` connects). SSH on port 22 is the only
# viable leg.
#
# `-L 8099:127.0.0.1:8099` asks THIS ssh client (arcturus) to listen on
# its OWN 127.0.0.1:8099 and forward anything that arrives there,
# outbound through this tunnel, to lyra's own 127.0.0.1:8099 -- the
# relay's `ExecStart` in cora-status-relay.service must keep binding
# 127.0.0.1, never 0.0.0.0, so nothing but this tunnel can reach it.
#
# An earlier version of this unit used `-R` here, which is backwards:
# `-R` makes the REMOTE side (lyra) listen and forward back to the
# LOCAL side (arcturus), the opposite of what a client with no inbound
# reachability needs. That shipped silently for days because a stray
# `cora-status-relay.service` had ALSO been enabled directly on
# arcturus (no `ConditionHost` guard on that unit at the time), so
# arcturus's own 127.0.0.1:8099 answered locally and every check looked
# green without the tunnel ever being exercised. Caught 2026-08-28 once
# STATUS_PUSH_ENABLED was actually flipped on and the relay on lyra
# never saw a producer connect despite arcturus logging `connected`.
#
# ServerAliveInterval/Count let ssh notice a dead network path and exit
# rather than sit in a half-broken state; ExitOnForwardFailure means a
# failed remote bind (port already taken on lyra) also exits rather than
# silently running with no working tunnel. Either way, Restart=always
# picks it back up.
#
# Install (systemd --user, no sudo, mirrors cora-api.service's install):
#
#   cp infra/status-relay/systemd/cora-status-tunnel.service \
#       ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cora-status-tunnel.service
#   systemctl --user status cora-status-tunnel.service
#
# Verify from arcturus, once both this and cora-status-relay.service are
# up: `curl -s -o /dev/null -w '%{http_code}\n' http://127.0.0.1:8099/`
# should print 401 (the relay is reachable and answering, just refusing
# the request for lacking the viewer Basic-auth credentials -- see
# cora-status-relay.service's own STATUS_RELAY_VIEWER_USER/PASSWORD) --
# all without this curl ever leaving arcturus.

[Unit]
Description=CORA status-push reverse tunnel to lyra (arcturus has no inbound reachability)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -L 8099:127.0.0.1:8099 2bmb@lyra
Restart=always
RestartSec=15
StandardOutput=append:/home/beams0/2BMB/dgursoy/cora-status-tunnel.log
StandardError=append:/home/beams0/2BMB/dgursoy/cora-status-tunnel.log

[Install]
WantedBy=default.target
