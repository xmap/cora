# Runs the status relay (infra/status-relay/relay.py) on the jump host
# that has internet reach (2-BM: lyra), receiving the live feed pushed
# outbound from the API host that has none (arcturus). See the module
# docstring in relay.py for why this exists as a separate host-layer
# process rather than an application module.
#
# Binds 127.0.0.1 ONLY, by design: a viewer reaches it the same way
# /docs is reached today, an SSH tunnel, not a direct network address.
# Widening the bind address later is a one-line ExecStart change; the
# viewer-side authentication that widening used to be blocked on now
# exists (STATUS_RELAY_VIEWER_USER/PASSWORD, HTTP Basic, every path but
# /ingest), added specifically because /run-history/<id> can now reach
# any run in the record on demand, not only the up-to-20 most recently
# pushed one. STATUS_RELAY_TOKEN below is a SEPARATE credential that
# gates only the PRODUCER's own /ingest connection.
#
# Reuses the same shared-NFS-home checkout and venv arcturus already
# runs from (`websockets` is already a dependency of apps/api, pulled
# in transitively via uvicorn[standard] even before this feature's
# explicit pin); nothing new is installed on lyra to run this.
#
# `2bmb`'s systemd --user linger was OFF on lyra (unlike arcturus, where
# it was already enabled) before this unit was installed; `loginctl
# enable-linger 2bmb` is required first or this service dies the moment
# nobody is logged in.
#
# Install (systemd --user, no sudo, mirrors cora-api.service's own
# install on arcturus):
#
#   mkdir -p ~/cora-status-relay-secrets   # or wherever you keep it
#   printf 'STATUS_RELAY_TOKEN=%s\nSTATUS_RELAY_VIEWER_USER=%s\nSTATUS_RELAY_VIEWER_PASSWORD=%s\n' \
#       '<paste the generated token>' '<pick a viewer username>' '<pick a viewer password>' \
#       > ~/cora-status-relay.env
#   chmod 600 ~/cora-status-relay.env
#   cp infra/status-relay/systemd/cora-status-relay.service \
#       ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cora-status-relay.service
#   systemctl --user status cora-status-relay.service
#
# The EnvironmentFile path below assumes the env file lives directly in
# $HOME; adjust both this unit and the printf above together if not.
#
# `ConditionHost=` matters: $HOME is NFS-shared with arcturus (both
# hosts read this same unit file), and this unit's own install steps
# have no host check baked into the shell commands. Without this guard,
# enabling it once from the wrong shell starts a second relay directly
# on arcturus, silently absorbing 127.0.0.1:8099 there and making every
# local reachability check pass without the real cross-host tunnel
# (cora-status-tunnel.service) ever being exercised -- exactly what
# happened 2026-08-28, caught only once STATUS_PUSH_ENABLED was flipped
# on for real and the relay on lyra never saw a producer connect.
#
# The value must be lyra's FULL hostname, not the bare jump-host name:
# systemd matches ConditionHost against plain `hostname` (the node's own
# idea of itself), and lyra's `hostname` returns the FQDN
# (lyra.xray.aps.anl.gov) while arcturus's returns the short form
# (arcturus) -- the two hosts are configured differently, verified by
# running `hostname` on each, not assumed. A bare `lyra` here looks
# right by eye and fails silently at start time.

[Unit]
Description=CORA status relay (receives the live 2-BM feed, serves the status page)
ConditionHost=lyra.xray.aps.anl.gov
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/beams0/2BMB/dgursoy/cora-status-relay.env
ExecStart=/home/beams0/2BMB/dgursoy/cora-main-deploy/apps/api/.venv/bin/python3 /home/beams0/2BMB/dgursoy/cora-main-deploy/infra/status-relay/relay.py --host 127.0.0.1 --port 8099
Restart=always
RestartSec=15
StandardOutput=append:/home/beams0/2BMB/dgursoy/cora-status-relay.log
StandardError=append:/home/beams0/2BMB/dgursoy/cora-status-relay.log

[Install]
WantedBy=default.target
