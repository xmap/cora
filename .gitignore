# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv-cache/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover

# Type checking
.pyright_cache/
.mypy_cache/
.ruff_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.cursor/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Node (frontend, later)
node_modules/
.next/
out/
*.log
.turbo/

# Logs
logs/
*.log

# MkDocs site (built output + staged copy of CONTRIBUTING)
/site/
/docs/reference/contributing.md

# Hero source PNGs (regenerated via scripts/generate_hero_images.py).
# Only the .webp variants are served by the site and committed.
/docs/assets/*.png

# Claude Code per-project state (settings, scheduled tasks, hooks, etc.)
.claude/*
!.claude/CLAUDE.md
!.claude/agents/
!.claude/agents/**

# Talks (slidev decks): track sources, ignore build artifacts.
# Decks are built in CI by .github/workflows/docs.yml and mounted under
# /talks/<slug>/ on the docs site.
talks/*/node_modules/
talks/*/dist/
talks/*/*.pdf

# Papers (LaTeX): track sources, ignore build artifacts. The venue class
# files (*.cls/*.bst/*.sty) are added per paper and not vendored here.
papers/*/*.aux
papers/*/*.log
papers/*/*.out
papers/*/*.bbl
papers/*/*.blg
papers/*/*.toc
papers/*/*.synctex.gz
papers/*/*.fls
papers/*/*.fdb_latexmk
papers/*/*.brf
papers/*/*.pdf
papers/*/_minted*/

# Paper working directories are local-only by default (drafts stay off the
# remote). The vaxautosci-scrubber paper is the exception and stays tracked.
# To publish another paper, add a matching negation below.
papers/*/
!papers/2026-vaxautosci-scrubber/

# Mutmut working tree (regenerated per audit; holds the AST-mutated copy
# of src/ + tests/ under apps/api/mutants/). Never committed.
apps/api/mutants/
apps/api/mutmut-stats.json

# Research notes and reverse-engineering working tree are tracked (surveys,
# per-beamline facts, candidate descriptors). Only the regenerable shallow-clone
# cache the extractor writes is ignored.
research/*/.cache/
research/.cache/
